---
// Header component
---
<header class="flex justify-between items-center w-full px-margin-mobile md:px-margin-desktop py-4 bg-transparent flat no shadows docked full-width top-0 z-50">
	<div class="font-display-lg text-[22px] sm:text-[32px] md:text-display-lg font-extrabold italic tracking-tighter text-primary-fixed uppercase select-none leading-none">
		YT-UNCLOGGED
	</div>
	<div class="flex items-center gap-6">
		<button id="open-settings" aria-label="settings" class="text-secondary hover:text-primary transition-colors hover:scale-105 transition-transform duration-200 focus:outline-none">
			<span class="material-symbols-outlined font-headline-md text-headline-md" style="font-variation-settings: 'FILL' 0;">settings</span>
		</button>
		<button id="open-history" aria-label="history" class="text-secondary hover:text-primary transition-colors hover:scale-105 transition-transform duration-200 focus:outline-none">
			<span class="material-symbols-outlined font-headline-md text-headline-md" style="font-variation-settings: 'FILL' 0;">history</span>
		</button>
	</div>
</header>
